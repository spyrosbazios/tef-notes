# Copy to `.env` (gitignored) beside docker-compose.yml and change what differs. Every line shows its default.

# The release to pull (the images' tag, e.g. 0.1.0); empty or unset: the latest. For a build from source with the
# extension (docker-compose.build.yml) it is also the extension's version, so set it there to the version you build.
# TEF_NOTES_VERSION=
# The public origin the clients reach. Only the extension build (docker-compose.build.yml) reads it: its update_url is
# built from it, and Chrome installs and updates an extension only from https, so use the reverse proxy's address
# (e.g. https://host.tailnet.ts.net:8097). A dashboard label in docker-compose.override.yml may use it too.
TEF_NOTES_URL=http://localhost:8097
# Host ports, bound to loopback only (there is no sign-in: put a reverse proxy on a private network in front).
PB_PORT=8097
AGENT_PORT=8098
# The server's time zone: a note it writes is dated, and named, by this zone's day, and a task's reminder time (no zone of its
# own) is read in it by the agent: set it to your own (an IANA name, e.g. Europe/Athens), or push reminders ring hours off.
TZ=UTC
# One directory per provider, each holding a file named `api-key` with the key alone. Mounted read-only and re-read on
# every use, so a new key needs no restart. Default: server/keys/<provider>. A missing key: auto-tagging and clip
# suggestions (typesafe), the clip's write-up and the agent (the model provider's), the agent's web search (exa) are off.
TEF_NOTES_KEY_TYPESAFE=./keys/typesafe
# The model provider's key; unset, it is ./keys/<TEF_NOTES_PROVIDER>, so switching provider needs no change here. Ollama has none.
# TEF_NOTES_KEY_LLM=./keys/deepseek
TEF_NOTES_KEY_EXA=./keys/exa
# A Google Maps Platform key with Places API (New) and Maps Static API enabled: a note's place search, its map and the
# agent's find_place. Missing: a note's place is typed by name, with no search or map.
TEF_NOTES_KEY_MAPS=./keys/maps
# Push reminders to the installed web app: the VAPID private key (`api-key`, made with `bunx web-push generate-vapid-keys`;
# the public key is derived from it) and a contact the push services may reach you at (mailto: or https). Empty: off.
TEF_NOTES_KEY_PUSH=./keys/push
TEF_NOTES_VAPID_SUBJECT=
# The extension's signing key (a PEM, inside server/), read by docker-compose.build.yml only; until it exists the image
# serves no extension.
TEF_NOTES_CRX_KEY=./no-crx-key
# The model provider for the chat agent and the server's clip and tag-description writing: deepseek, anthropic, openai,
# xai (Grok), qwen, zai (Z.ai) or ollama. One per server; the table of defaults is ../docs/ai-providers.md.
TEF_NOTES_PROVIDER=deepseek
# The model; empty: the provider's default. Ollama has no default: name a model you have pulled.
TEF_NOTES_MODEL=
# The provider's API root; empty: its own (e.g. Qwen's China region: https://dashscope.aliyuncs.com/compatible-mode/v1).
TEF_NOTES_LLM_URL=
# Ollama only: where it serves, e.g. http://host.docker.internal:11434 for one on the Docker host.
TEF_NOTES_OLLAMA_URL=
# 1: the agent also serves its note and task tools over MCP at /agent/mcp, for another agent harness (Claude Code,
# Codex, Cursor …) to use with its own model. Same reach as the rest: whoever reaches the proxy can use it.
TEF_NOTES_MCP=0
# Voice input: where the agent reaches the speech-to-text service, the `stt` container on the compose network (README.md
# "Voice input"). Unset: on. Set it empty (TEF_NOTES_STT=) to turn voice input off: the apps hide their mic, the routes
# answer 404, and the stt container can be stopped.
# TEF_NOTES_STT=http://stt:8099
