# The build context is the repo root, which holds the live database (server/pb_data) and gigabytes of
# node_modules: send only what the web, extension and hooks builds read.
*
!web
web/node_modules
web/dist
!packages/core/src
!packages/core/vite.ts
!assets/fonts
!assets/icon.png
!extension
extension/node_modules
extension/dist
!scripts/version.sh
!server/pb_migrations
!server/pb_hooks
server/pb_hooks/lib/core.js
!server/agent/tsconfig.json
!server/agent/src/note-index.ts
!server/agent/src/providers.ts
