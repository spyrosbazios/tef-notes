{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* the shared core and palette (packages/core), imported as @/core */
    "paths": { "@/core/*": ["../packages/core/src/*"] },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["scripts"]
}
